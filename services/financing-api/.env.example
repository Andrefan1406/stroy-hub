# Содержимое JSON-ключа сервисного аккаунта Google ЦЕЛИКОМ, одной строкой
# (тот же принцип, что и GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON в server/.env) —
# сам ключ НЕЛЬЗЯ коммитить в репозиторий.
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}

# Адрес Node-бэкенда (локально — дефолт подходит; на Render — реальный URL сервиса).
NODE_API_URL=http://localhost:4000

# То же самое значение, что и INTERNAL_API_KEY в корневом .env Node-сервера.
INTERNAL_API_KEY=
