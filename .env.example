# Пример переменных окружения. Скопируйте в .env и подставьте значения; сам .env не коммитится.
# Фронтенд (CRA) подставляет REACT_APP_* при сборке — после смены значения сайт нужно пересобрать.

# --- Адреса Google Apps Script (веб-приложение, URL вида https://script.google.com/macros/s/.../exec) ---
# Где взять: проект в script.google.com → Deploy → Manage deployments → Web app URL.
# Исходники скриптов: google-apps-scripts/. Сводка: src/config/scriptUrls.js.
# У каждой формы есть запасной адрес в коде — переменная нужна, только чтобы его заменить.
REACT_APP_CONCRETE_SCRIPT_URL=
REACT_APP_ELEC_SCRIPT_URL=
REACT_APP_GEO_SCRIPT_URL=
REACT_APP_EQUIPMENT_SCRIPT_URL=
REACT_APP_BLB_SCRIPT_URL=
REACT_APP_ZNB_SCRIPT_URL=
REACT_APP_LAB_SCRIPT_URL=
REACT_APP_PEOPLE_REPORT_SCRIPT_URL=

# --- Бэкенд ---
REACT_APP_CONCRETE_CHAT_API_URL=http://localhost:4000
